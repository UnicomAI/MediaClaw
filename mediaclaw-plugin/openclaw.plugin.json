{
  "id": "mediaclaw",
  "name": "MediaClaw",
  "description": "联通元景媒体生成：文生图、图文问答、文生视频。支持 yuanjing 和 sglang 两种提供商，可灵活配置每个能力使用的提供商，支持能力级别独立端点配置。",
  "configSchema": {
    "type": "object",
    "definitions": {
      "yuanjingOverride": {
        "type": "object",
        "description": "覆盖全局 yuanjing 配置",
        "properties": {
          "apiKey": {
            "type": "string",
            "description": "联通元景 API Key"
          },
          "baseUrl": {
            "type": "string",
            "description": "yuanjing API Base URL"
          }
        }
      },
      "sglangOverride": {
        "type": "object",
        "description": "覆盖全局 sglang 配置",
        "properties": {
          "baseUrl": {
            "type": "string",
            "description": "SGLang 服务 Base URL"
          },
          "apiKey": {
            "type": "string",
            "description": "SGLang API Key"
          },
          "apiPath": {
            "type": "string",
            "description": "SGLang API 路径前缀"
          }
        }
      },
      "capabilityConfig": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["yuanjing", "sglang"],
            "description": "使用的提供商类型，默认为 yuanjing"
          },
          "yuanjing": {
            "$ref": "#/definitions/yuanjingOverride"
          },
          "sglang": {
            "$ref": "#/definitions/sglangOverride"
          },
          "videoModel": {
            "type": "string",
            "enum": ["wan", "kling"],
            "description": "视频生成模型（仅 provider=yuanjing 时有效）：wan（默认）或 kling"
          }
        },
        "additionalProperties": false
      }
    },
    "properties": {
      "providers": {
        "type": "object",
        "description": "提供商配置：可同时配置多个提供商，灵活组合使用",
        "properties": {
          "yuanjing": {
            "type": "object",
            "description": "联通元景 API 配置",
            "properties": {
              "apiKey": {
                "type": "string",
                "description": "联通元景 API Key"
              },
              "baseUrl": {
                "type": "string",
                "default": "https://maas-api.ai-yuanjing.com",
                "description": "yuanjing API Base URL"
              }
            },
            "required": ["apiKey"]
          },
          "sglang": {
            "type": "object",
            "description": "SGLang (OpenAI兼容) API 配置",
            "properties": {
              "baseUrl": {
                "type": "string",
                "default": "http://localhost:30010",
                "description": "SGLang 服务 Base URL"
              },
              "apiKey": {
                "type": "string",
                "default": "sk-dummy",
                "description": "SGLang API Key"
              },
              "apiPath": {
                "type": "string",
                "default": "",
                "description": "SGLang API 路径前缀（如 /v1 或 /openapi/v1/web_control）"
              }
            }
          }
        }
      },
      "capabilities": {
        "type": "object",
        "description": "能力路由配置：指定每个能力使用哪个提供商。支持简单格式（字符串）或完整格式（对象）",
        "properties": {
          "textToImage": {
            "description": "文生图能力配置",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing", "sglang"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "textToVideo": {
            "description": "文生视频能力配置（支持 videoModel 选择 wan 或 kling）",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing", "sglang"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "imageToVideo": {
            "description": "图生视频能力配置（支持 videoModel 选择 wan 或 kling）",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing", "sglang"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "imagesToVideo": {
            "description": "多图生视频能力配置（仅支持 yuanjing，支持 videoModel 选择 wan 或 kling）",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "imageQA": {
            "description": "图文问答能力配置",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing", "sglang"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "textToSpeech": {
            "description": "语音合成能力配置（仅支持 yuanjing）",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          },
          "digitalAvatar": {
            "description": "数字人生成能力配置（仅支持 yuanjing）",
            "oneOf": [
              { "type": "string", "enum": ["yuanjing"] },
              { "$ref": "#/definitions/capabilityConfig" }
            ]
          }
        },
        "additionalProperties": false
      },
      "defaultProvider": {
        "type": "string",
        "enum": ["yuanjing", "sglang"],
        "default": "yuanjing",
        "description": "默认提供商：未在 capabilities 中指定的能力使用此提供商"
      },
      "outputDir": {
        "type": "string",
        "description": "默认输出目录"
      },
      "videoPollInterval": {
        "type": "number",
        "default": 5000,
        "description": "视频轮询间隔（毫秒）"
      },
      "videoMaxWaitTime": {
        "type": "number",
        "default": 300000,
        "description": "视频最大等待时间（毫秒）"
      }
    },
    "required": []
  },
  "skills": ["./skills"]
}
